LOOPHARVEST_ENVIRONMENT=local
LOOPHARVEST_APP_NAME=LoopHarvest API
LOOPHARVEST_API_PREFIX=/api/v1
LOOPHARVEST_SHOW_DOCS=true
LOOPHARVEST_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
LOOPHARVEST_CORS_ORIGIN_REGEX=^https?://(localhost|127\\.0\\.0\\.1|192\\.168\\.\\d{1,3}\\.\\d{1,3}|10\\.\\d{1,3}\\.\\d{1,3}\\.\\d{1,3}|172\\.(1[6-9]|2\\d|3[0-1])\\.\\d{1,3}\\.\\d{1,3})(:\\d+)?$
LOOPHARVEST_SUPABASE_URL=https://your-project-ref.supabase.co
# Use the project base URL above, not the Postgres connection string and not /rest/v1.
LOOPHARVEST_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
LOOPHARVEST_SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
